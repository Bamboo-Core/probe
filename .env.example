# ISP.Tools Probe Configuration

# Cluster Configuration
CLUSTER_ENABLED=true
NUM_WORKERS=4

# Application Configuration
PORT=8000
SHOW_REQUEST_LOGS=false

# Segredo compartilhado com o probe-collector (header X-Probe-Key em toda
# requisição). Quando definido, é a ÚNICA forma de acesso — a allowlist de IP
# legada deixa de valer. Sem isso definido, a probe roda no modo legado
# (allowlist de IP) só até a probe-collector correspondente ser atualizada.
PROBE_SHARED_SECRET=


# Configuração específica do módulo MTU
MTU_TIMEOUT=1000 # 1000ms para descoberta de MTU
MTU_TEST_DELAY=20 # 20ms de delay entre testes

